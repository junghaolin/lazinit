# Lazinit Bash 強化配置
# 適用於：不方便裝 Zsh 的極簡開發環境

# ==========================
# 0. 啟動 ble.sh (核心：灰色補全與高亮)
# ==========================
if [[ $- == *i* ]] && [ -f ~/.local/share/blesh/ble.sh ]; then
  # 採用官方推薦的最強掛載模式
  source ~/.local/share/blesh/ble.sh --attach=prompt
  
  # ble.sh 配置：開啟自動建議
  bleopt auto_complete=1
  ble-face -s auto_complete 'fg=242' # 淡淡的灰色
fi

# ==========================
# 1. 核心 Alias
# ==========================
if [ -x /usr/bin/dircolors ]; then
    alias ls='ls --color=auto'
    alias grep='grep --color=auto'
fi

alias l='ls -CF'
alias la='ls -A'
alias ll='ls -alF'
alias ..='cd ..'
alias ...='cd ../..'

# Git 常用縮寫
alias gst='git status -sb'
alias glg="git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"
alias gco='git checkout'
alias gcm='git commit -m'

# ==========================
# 2. 智慧型 Prompt (雙行 + Git 支援)
# ==========================
parse_git_branch() {
    git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/ (\1)/'
}

COLOR_USER="\[\033[01;32m\]"
COLOR_HOST="\[\033[01;32m\]"
COLOR_PATH="\[\033[01;34m\]"
COLOR_GIT="\[\033[01;33m\]"
COLOR_RESET="\[\033[00m\]"

# 注意：如果 ble.sh 已啟動，它會接管 PS1
export PS1="${COLOR_USER}\u${COLOR_RESET}@${COLOR_HOST}\h${COLOR_RESET}:${COLOR_PATH}\w${COLOR_GIT}\$(parse_git_branch)${COLOR_RESET}\n\$ "

# ==========================
# 3. 歷史搜尋強化 (向上鍵自動補齊)
# ==========================
if [[ $- == *i* ]]; then
    bind '"\e[A": history-search-backward'
    bind '"\e[B": history-search-forward'
fi

# ==========================
# 4. FZF 整合
# ==========================
if [ -f /usr/share/doc/fzf/examples/key-bindings.bash ]; then
  source /usr/share/doc/fzf/examples/key-bindings.bash
elif [ -f ~/.fzf.bash ]; then
  source ~/.fzf.bash
fi

# ==========================
# 5. 路徑優化
# ==========================
export PATH="$HOME/.local/bin:$HOME/lazinit/utils:$PATH"
