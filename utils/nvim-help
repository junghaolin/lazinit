#!/bin/bash
# Neovim (LazyVim 客製版) 快速小抄 (Cheat Sheet)

# 顏色定義
BLUE='\033[1;34m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
CYAN='\033[1;36m'
MAGENTA='\033[1;35m'
NC='\033[0m' # No Color

echo -e "${CYAN}======================================================${NC}"
echo -e "${CYAN}        🚀 Neovim (LazyVim 客製版) 快速小抄           ${NC}"
echo -e "${CYAN}======================================================${NC}"
echo -e "你的 Leader 鍵已設定為: ${YELLOW}[空白鍵] (Space)${NC}\n"

echo -e "${BLUE}▶ 檔案與總覽 (Files & Explorer)${NC}"
echo -e "  ${YELLOW}<Space> e${NC}             打開/關閉 左側檔案總管 (Neo-tree)"
echo -e "  ${YELLOW}<Space> f f${NC}           搜尋檔案 (Find Files - Telescope/fzf)"
echo -e "  ${YELLOW}<Space> s g${NC}           全文搜尋 (Search Grep - Telescope/fzf)"
echo -e "  ${YELLOW}<Space> f r${NC}           最近開啟的檔案 (Recent Files)"
echo -e "  ${YELLOW}<Space> /${NC}             在當前檔案內模糊搜尋\n"

echo -e "${BLUE}▶ 視窗與終端機 (Windows & Terminal)${NC}"
echo -e "  ${YELLOW}<Space> t${NC}             打開/隱藏 下方終端機 (ToggleTerm, 佔 1/3 高度)"
echo -e "  ${YELLOW}<Space> |${NC} 或 ${YELLOW}<C-w> v${NC}   垂直分割視窗 (左右分)"
echo -e "  ${YELLOW}<Space> -${NC} 或 ${YELLOW}<C-w> s${NC}   水平分割視窗 (上下分)"
echo -e "  ${YELLOW}<Space> w d${NC}           關閉當前分割視窗 (Window Delete)"
echo -e "  ${MAGENTA}在終端機內:${NC}"
echo -e "    ${GREEN}<Ctrl+t>${NC} 或 ${GREEN}<Esc>${NC}     退出終端機輸入模式，回到 Normal Mode"
echo -e "    ${GREEN}<Ctrl+h/j/k/l>${NC}      直接跳轉到 左/下/上/右 的其他 Neovim 視窗\n"

echo -e "${BLUE}▶ 緩衝區 (Buffers / Tabs)${NC}"
echo -e "  ${YELLOW}<Tab>${NC}               切換到 下一個 檔案/標籤"
echo -e "  ${YELLOW}<Shift+Tab>${NC}         切換到 上一個 檔案/標籤"
echo -e "  ${YELLOW}<Space> b d${NC}           關閉當前檔案 (Buffer Delete)"
echo -e "  ${YELLOW}<Space> b p${NC}           將當前檔案「釘選」 (Pin Buffer)\n"

echo -e "${BLUE}▶ 程式碼與編輯 (Code & Editing)${NC}"
echo -e "  ${YELLOW}g c c${NC}                 單行註解/取消註解"
echo -e "  ${YELLOW}g c${NC} (Visual 模式下)   區塊註解"
echo -e "  ${YELLOW}v${NC} 然後選取，按 ${YELLOW}y${NC}      複製到系統剪貼簿 (已預設開啟 unnamedplus)"
echo -e "  ${YELLOW}p${NC}                     貼上系統剪貼簿的內容"
echo -e "  ${YELLOW}<Ctrl+s>${NC}            自動排版/格式化當前檔案 (Format)"
echo -e "  ${YELLOW}<Space> c a${NC}           程式碼修正建議 (Code Action, LSP 提供)"
echo -e "  ${YELLOW}K${NC} (大寫K)             查看游標下函式的說明文件 (Hover Hover)"
echo -e "  ${YELLOW}g d${NC}                   跳轉到定義 (Go to Definition)"
echo -e "  ${YELLOW}g r${NC}                   查看哪裡引用了這個變數/函式 (References)"
echo -e "  ${YELLOW}<Space> c r${NC}           全域重新命名變數/函式 (Rename)\n"

echo -e "${BLUE}▶ 錯誤與診斷 (Diagnostics)${NC}"
echo -e "  ${YELLOW}[ d${NC} / ${YELLOW}] d${NC}             跳到 上一個/下一個 錯誤或警告"
echo -e "  ${YELLOW}<Space> x x${NC}           開啟底部錯誤清單總覽 (Trouble)"
echo -e "  ${YELLOW}<Space> u d${NC}           一鍵隱藏/顯示 所有錯誤提示文字 (UI Diagnostics Toggle)\n"

echo -e "${BLUE}▶ 外掛管理與 Git (Plugins & Git)${NC}"
echo -e "  ${YELLOW}<Space> l${NC}             開啟 Lazy 外掛管理面板 (可按 U 更新)"
echo -e "  ${YELLOW}<Space> c m${NC}           開啟 Mason 面板 (管理 LSP、Linter 等)"
echo -e "  ${YELLOW}<Space> g g${NC}           開啟 Lazygit 視覺化 Git 介面 (亦可在終端機輸入 ${GREEN}lg${NC})\n"

echo -e "${CYAN}======================================================${NC}"
