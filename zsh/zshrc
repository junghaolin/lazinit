export TERM=xterm-256color
fastfetch

# ============= 工具函數 =============
find_dir() {
  for var in "$@"; do
    if [ -e "$var" ]; then
      echo "$var"
      return 0
    fi
  done
  return 1
}

# ============= Instant Prompt =============
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ============= Zinit 插件管理器 =============
if [[ ! -f $HOME/.local/share/zinit/zinit.git/zinit.zsh ]]; then
    print -P "%F{33} %F{220}Installing Zinit…%f"
    command mkdir -p "$HOME/.local/share/zinit" && command chmod g-rwX "$HOME/.local/share/zinit"
    command git clone https://github.com/zdharma-continuum/zinit "$HOME/.local/share/zinit/zinit.git"
fi

source "$HOME/.local/share/zinit/zinit.git/zinit.zsh"
autoload -Uz _zinit
(( ${+_comps} )) && _comps[zinit]=_zinit

# ============= 核心模組 (同步載入) =============
zinit ice depth=1; zinit light romkatv/powerlevel10k
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

zinit snippet OMZ::lib/key-bindings.zsh
zinit snippet OMZ::lib/completion.zsh

# ============= 附加功能 (Turbo Mode) =============
zinit wait'0' lucid for \
    OMZ::plugins/sudo/sudo.plugin.zsh \
    zdharma-continuum/zinit-annex-as-monitor \
    zdharma-continuum/zinit-annex-bin-gem-node \
    zdharma-continuum/fast-syntax-highlighting \
    blockf zsh-users/zsh-completions \
    atload"!_zsh_autosuggest_start" zsh-users/zsh-autosuggestions

# ============= Zsh 選項設定 =============
setopt AUTO_CD                   # 直接輸入目錄名
setopt AUTO_PUSHD                # cd 自動紀錄歷史
setopt PUSHD_IGNORE_DUPS         # 不重複紀錄路徑
setopt CORRECT                   # 命令糾錯
setopt INTERACTIVE_COMMENTS      # 交互模式支持註釋
unsetopt BEEP                    # 靜音

# ============= History 設定 =============
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt EXTENDED_HISTORY          # 紀錄時間
setopt INC_APPEND_HISTORY        # 立即寫入
setopt SHARE_HISTORY             # 跨 Session 共享
setopt HIST_IGNORE_ALL_DUPS      # 忽略重複
setopt HIST_REDUCE_BLANKS        # 移除空格
setopt HIST_IGNORE_SPACE         # 忽略空格開頭的命令
setopt HIST_SAVE_NO_DUPS         # 寫入檔案時不重複

# ============= 補全美化 (精煉版) =============
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' menu select
zstyle ':completion:*:*:*:*:descriptions' format '%F{green}-- %d --%f'
zstyle ':completion:*:messages' format ' %F{purple} -- %d --%f'
zstyle ':completion:*:warnings' format ' %F{red}No matches for:%f %d'
zstyle ':completion:*:*:*:*:corrections' format '%F{yellow}!- %d (errors: %e) -!%f'
zstyle ':completion:*:*:-command-:*:' group-name ''

# ============= Lazy Loading Scripts =============
if [[ -o interactive ]]; then
  # 載入 v2 系列懶載入腳本
  for f in ls vi grc grep cat; do
    [ -f ~/.zsh/lazy_${f}_v2.zsh ] && source ~/.zsh/lazy_${f}_v2.zsh
  done
fi

# ============= PATH 極致整合 =============
typeset -U path
# 尋找工具路徑
GO_DIR=$(find_dir "$HOME/go" "$HOME/.local/opt/go" "/usr/local/go")
CONDA_BASE=$(find_dir "/opt/miniconda3" "$HOME/miniconda3" "$HOME/.miniconda3")

path=(
  $HOME/lazinit/utils
  $HOME/.local/bin
  $HOME/.opencode/bin
  $HOME/flutter/bin
  $HOME/.lmstudio/bin
  $([ -n "$GO_DIR" ] && echo "$GO_DIR/bin")
  $([ -d "/usr/local/go/bin" ] && echo "/usr/local/go/bin")
  $path
)
[ -n "$GO_DIR" ] && export GO_PATH="$GO_DIR"

# ============= Conda 懶載入 (精確版) =============
_load_conda() {
  if [ -n "$CONDA_BASE" ]; then
    if [ -f "$CONDA_BASE/etc/profile.d/conda.sh" ]; then
      . "$CONDA_BASE/etc/profile.d/conda.sh"
    else
      path=($CONDA_BASE/bin $path)
    fi
  fi
  unfunction conda python python3 pip pip3 2>/dev/null
}
conda python python3 pip pip3() { _load_conda; "$0" "$@"; }

# ============= NVM 懶載入 (精確版) =============
_load_nvm() {
  export NVM_DIR=$(find_dir "/usr/local/opt/nvm" "$HOME/.nvm")
  if [ -n "$NVM_DIR" ]; then
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
  fi
  unfunction nvm node npm yarn npx pnpm corepack 2>/dev/null
}
nvm node npm yarn npx pnpm corepack() { _load_nvm; "$0" "$@"; }

# ============= 其他設定 =============
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8
export FZF_DEFAULT_COMMAND='fd --type f --follow --exclude .git'
export HSA_OVERRIDE_GFX_VERSION=11.0.0

# Aliases
alias dive="docker run -ti --rm -v /var/run/docker.sock:/var/run/docker.sock wagoodman/dive"
alias dfimage="docker run -v /var/run/docker.sock:/var/run/docker.sock --rm alpine/dfimage"
alias fzf='fzf --ansi'
alias jo="ssh jo" ju="ssh ju" dut="ssh -t dut"

# Lazygit 視覺化工具
if command -v lazygit >/dev/null 2>&1; then
    alias lg='lazygit'
fi

# 智慧遠端連線 (SSH + Tmux)
ssht() {
    ssh -t "$@" "tmux new -A -s main"
}

# Bindings
bindkey '^K' history-search-backward
bindkey '^J' history-search-forward

# Tilix/VTE
if [ -n "$TILIX_ID" ] || [ -n "$VTE_VERSION" ]; then
  [ -f /etc/profile.d/vte-2.91.sh ] && source /etc/profile.d/vte-2.91.sh
fi

# asdf & local config
[ -f "$HOME/.asdf/asdf.sh" ] && . "$HOME/.asdf/asdf.sh"
[ -f ~/.zshrc.local ] && source ~/.zshrc.local

export PATH
